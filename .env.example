# Local-only defaults. Copy to .env and replace credentials before use.
APP_TIMEZONE=America/Toronto
APP_ENVIRONMENT=development
API_PORT=8000

POSTGRES_DB=lifeagent
POSTGRES_USER=lifeagent
POSTGRES_PASSWORD=change-me-locally
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Ollama runs natively on macOS; it is intentionally not a Compose service.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-32gb:latest
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_BATCH=32
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_INPUT_TOKENS=6000
OLLAMA_MAX_OUTPUT_TOKENS=384
OLLAMA_REPAIR_ATTEMPTS=1
OLLAMA_SEED=1729
OLLAMA_REASONING=false
# Pinned only after the saved Phase 1 benchmark passed.
OLLAMA_MODEL_DIGEST=d039cde69ac1f5a43d5134182adfefa65bdb533362a625b936e6171a53296eb3

# The remaining values are reserved for later connector phases.
EMBEDDING_MODEL=qwen3-embedding:0.6b
ARTIFACT_ROOT=/var/lib/lifeagent/artifacts
ARTIFACT_RETENTION_DAYS=30
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300
RETRY_JITTER_RATIO=0.2
CONNECTOR_TIMEOUT_SECONDS=10
WORKER_CONCURRENCY=1
QUEUE_STALLED_AFTER_SECONDS=120
LANGGRAPH_STRICT_MSGPACK=true
REPOSITORY_ALLOWLIST=[]
REPOSITORY_ALLOWLIST_VERSION=
DISCORD_TARGET_CHANNELS=[]
DISCORD_CODE_REVIEW_CHANNEL_ID=
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576
GIT_CLONE_TIMEOUT_SECONDS=60
CODE_COMMAND_TIMEOUT_SECONDS=120
CODE_COMMAND_OUTPUT_BYTES=262144
REVIEW_MIN_CONFIDENCE=0.75

# Toronto-local schedules; workers remain idle until their later phases.
CODE_REVIEW_SCHEDULE=18:00
ACADEMIC_MORNING_SCHEDULE=08:00
ACADEMIC_END_OF_DAY_SCHEDULE=21:00
FINANCE_MARKET_OPEN_SCHEDULE=09:00

# Keep all eight source slots empty until the exact allowlist, entitlement,
# and licensing boundaries are approved. Never substitute open web search.
FINANCE_SOURCE_1_BASE_URL=
FINANCE_SOURCE_2_BASE_URL=
FINANCE_SOURCE_3_BASE_URL=
FINANCE_SOURCE_4_BASE_URL=
FINANCE_SOURCE_5_BASE_URL=
FINANCE_SOURCE_6_BASE_URL=
FINANCE_SOURCE_7_BASE_URL=
FINANCE_SOURCE_8_BASE_URL=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_SECRET=
NOTION_TOKEN=
FINANCE_SOURCE_ALLOWLIST_VERSION=
