# Local-only defaults. Copy to .env and replace credentials before use.
APP_TIMEZONE=America/Toronto
APP_ENVIRONMENT=development
API_PORT=8000

POSTGRES_DB=lifeagent
POSTGRES_USER=lifeagent
POSTGRES_PASSWORD=change-me-locally
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Ollama runs natively on macOS; it is intentionally not a Compose service.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-32gb:latest
MODEL_TRIGGER_MODE=discord_mentions_only
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_BATCH=32
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MODEL_KEEP_ALIVE_SECONDS=300
OLLAMA_STARTUP_TIMEOUT_SECONDS=30
OLLAMA_MAX_INPUT_TOKENS=6000
OLLAMA_MAX_OUTPUT_TOKENS=384
OLLAMA_REPAIR_ATTEMPTS=1
OLLAMA_SEED=1729
OLLAMA_REASONING=false
# Pinned only after the saved Phase 1 benchmark passed.
OLLAMA_MODEL_DIGEST=d039cde69ac1f5a43d5134182adfefa65bdb533362a625b936e6171a53296eb3

# The remaining values are reserved for later connector phases.
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_MODEL_DIGEST=
EMBEDDING_TIMEOUT_SECONDS=30
ARTIFACT_ROOT=/var/lib/lifeagent/artifacts
ARTIFACT_RETENTION_DAYS=30
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300
RETRY_JITTER_RATIO=0.2
CONNECTOR_TIMEOUT_SECONDS=10
WORKER_CONCURRENCY=1
QUEUE_STALLED_AFTER_SECONDS=120
LANGGRAPH_STRICT_MSGPACK=true
REPOSITORY_ALLOWLIST=[]
REPOSITORY_ALLOWLIST_VERSION=
DISCORD_TARGET_CHANNELS=[]
DISCORD_CODE_REVIEW_CHANNEL_ID=
DISCORD_FINANCE_CHANNEL_ID=
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576
GIT_CLONE_TIMEOUT_SECONDS=60
CODE_COMMAND_TIMEOUT_SECONDS=120
CODE_COMMAND_OUTPUT_BYTES=262144
REVIEW_MIN_CONFIDENCE=0.75
CODE_REVIEW_QUICK_SCAN_ENABLED=true
CODE_REVIEW_CATCHUP_ENABLED=false
CODE_REVIEW_CATCHUP_MAX_DAYS=3
CODE_REVIEW_DAILY_MAX_COMMITS=50
CODE_REVIEW_PROFILE_REFRESH_DAYS=30
CODE_REVIEW_DISCOVERY_SCOPE=github-installation
GITHUB_DISCOVERY_PAGE_SIZE=50
GITHUB_MIN_CALL_INTERVAL_SECONDS=2
NOTION_ATTACHMENT_MAX_BYTES=25165824
NOTION_MATERIAL_MAX_BLOCK_DEPTH=8
NOTION_MATERIAL_MAX_BLOCKS=1000
NOTION_MATERIAL_MAX_CURSOR_PAGES=20
ACADEMIC_MATERIAL_PDF_MAX_PAGES=15
ACADEMIC_MATERIAL_OCR_TIMEOUT_SECONDS=30
ACADEMIC_MATERIAL_OCR_MIN_PAGE_CHARS=24
ACADEMIC_MATERIAL_RETRIEVAL_LIMIT=8
ACADEMIC_MATERIAL_AGENT_MAX_TURNS=4
ACADEMIC_MATERIAL_PROMPT_MAX_CHARS=16000
ACADEMIC_PLAN_HORIZON_DAYS=14
ACADEMIC_BUFFER_RATIO=0.15
ACADEMIC_DEFAULT_BLOCK_MINUTES=60
ACADEMIC_MEMORY_ENABLED=true
ACADEMIC_MEMORY_DEFAULT_PRACTICE_MINUTES=30
ACADEMIC_MEMORY_SNOOZE_AFTER_MISSED_CHECKINS=2
ACADEMIC_MEMORY_DELETE_AFTER_MISSED_CHECKINS=5
ACADEMIC_SYNC_LOOKBACK_DAYS=2
ACADEMIC_CONFIRMATION_TTL_HOURS=24

# Scheduled values remain deterministic maintenance metadata. They are not
# executable Qwen triggers; authorized Discord work is the only model trigger.
CODE_REVIEW_SCHEDULE=18:00
ACADEMIC_MORNING_SCHEDULE=08:00
ACADEMIC_END_OF_DAY_SCHEDULE=21:00
FINANCE_MARKET_OPEN_SCHEDULE=09:00
OPS_CONSOLE_USERNAME=
OPS_CONSOLE_PASSWORD=

# Approved source allowlist. V2 is the configured public-first architecture.
# Its database records remain fail-closed until endpoint review, individual
# audited source approvals, and a delivery-disabled dry briefing are complete.
# Never substitute open web search for a missing or failed source.
FINANCE_SOURCE_ALLOWLIST_VERSION=finance-sources-2026.09-v2
# v2 public baseline: no paid vendor keys are required in bulk mode.
SEC_USER_AGENT=LifeAgent/0.1 contact@example.com
FINANCE_EIA_MODE=bulk
EIA_API_KEY=
FINANCE_FEED_POLL_MINUTES=10
FINANCE_FEDERAL_REGISTER_POLL_MINUTES=60
FINANCE_EIA_BULK_POLL_MINUTES=720
FINANCE_EIA_API_POLL_MINUTES=60
FINANCE_ETF_POLL_MINUTES=1440
FINANCE_COLD_START_BACKFILL_HOURS=24
FINANCE_REGISTRY_MAX_FANOUT=20
FINANCE_BULK_MAX_PAYLOAD_BYTES=67108864
# Exceptional legacy-v1 credentials retained only because the v2 rollout
# requirements explicitly requested v1 rollback compatibility. They are not
# part of the configured default or the public baseline.
DVIDS_API_KEY=
ALPHA_VANTAGE_API_KEY=
BENZINGA_API_TOKEN=
FMP_API_KEY=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_SECRET=
# Generated in a separate mode-0600 key file by lifeagent_host_runtime.sh deploy.
# Leave this blank in .env; the native daemon exports the generated value to Compose.
DISCORD_HOST_HANDOFF_SECRET=
DISCORD_HANDOFF_MAX_BODY_BYTES=4096
DISCORD_HANDOFF_MAX_CLOCK_SKEW_SECONDS=60
DISCORD_HANDOFF_REQUEST_TIMEOUT_SECONDS=10
DISCORD_HANDOFF_RETRY_ATTEMPTS=3
LIFEAGENT_DOCKER_DESKTOP_TIMEOUT_SECONDS=120
LIFEAGENT_COMPOSE_WAIT_SECONDS=180
LIFEAGENT_API_LIVE_TIMEOUT_SECONDS=60
LIFEAGENT_WAKE_OUTBOX_RETENTION_SECONDS=86400
NOTION_TOKEN=
NOTION_COURSES_DATABASE_ID=
# Deprecated migration metadata only; academic sync never reads these IDs.
NOTION_ASSESSMENTS_DATABASE_ID=
NOTION_STUDY_BLOCKS_DATABASE_ID=
DISCORD_ACADEMIC_CHANNEL_ID=
DISCORD_ACADEMIC_AUTHORIZED_USER_IDS=[]
DISCORD_ACADEMIC_MESSAGE_CONTENT_ENABLED=false

DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_PUBLIC_KEY=your_public_key_here
