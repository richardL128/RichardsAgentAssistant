# Local-only defaults. Copy to .env and replace credentials before use.
APP_TIMEZONE=America/Toronto
APP_ENVIRONMENT=development
API_PORT=8000

POSTGRES_DB=lifeagent
POSTGRES_USER=lifeagent
POSTGRES_PASSWORD=change-me-locally
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Ollama runs natively on macOS; it is intentionally not a Compose service.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-32gb:latest
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_BATCH=32
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_INPUT_TOKENS=6000
OLLAMA_MAX_OUTPUT_TOKENS=384
OLLAMA_REPAIR_ATTEMPTS=1
OLLAMA_SEED=1729
OLLAMA_REASONING=false
# Pinned only after the saved Phase 1 benchmark passed.
OLLAMA_MODEL_DIGEST=d039cde69ac1f5a43d5134182adfefa65bdb533362a625b936e6171a53296eb3

# The remaining values are reserved for later connector phases.
EMBEDDING_MODEL=qwen3-embedding:0.6b
ARTIFACT_ROOT=/var/lib/lifeagent/artifacts
ARTIFACT_RETENTION_DAYS=30
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300
RETRY_JITTER_RATIO=0.2
CONNECTOR_TIMEOUT_SECONDS=10
WORKER_CONCURRENCY=1
QUEUE_STALLED_AFTER_SECONDS=120
LANGGRAPH_STRICT_MSGPACK=true
REPOSITORY_ALLOWLIST=[]
REPOSITORY_ALLOWLIST_VERSION=
DISCORD_TARGET_CHANNELS=[]
DISCORD_CODE_REVIEW_CHANNEL_ID=
DISCORD_FINANCE_CHANNEL_ID=
GITHUB_WEBHOOK_MAX_BODY_BYTES=1048576
GIT_CLONE_TIMEOUT_SECONDS=60
CODE_COMMAND_TIMEOUT_SECONDS=120
CODE_COMMAND_OUTPUT_BYTES=262144
REVIEW_MIN_CONFIDENCE=0.75
CODE_REVIEW_QUICK_SCAN_ENABLED=true
CODE_REVIEW_CATCHUP_ENABLED=false
CODE_REVIEW_CATCHUP_MAX_DAYS=3
CODE_REVIEW_DAILY_MAX_COMMITS=50
CODE_REVIEW_PROFILE_REFRESH_DAYS=30
CODE_REVIEW_DISCOVERY_SCOPE=github-installation
GITHUB_DISCOVERY_PAGE_SIZE=50
GITHUB_MIN_CALL_INTERVAL_SECONDS=2
NOTION_ATTACHMENT_MAX_BYTES=25165824
ACADEMIC_PLAN_HORIZON_DAYS=14
ACADEMIC_BUFFER_RATIO=0.15
ACADEMIC_DEFAULT_BLOCK_MINUTES=60
ACADEMIC_SYNC_LOOKBACK_DAYS=2
ACADEMIC_CONFIRMATION_TTL_HOURS=24

# Toronto-local schedules. Code review runs nightly; later agent handlers remain gated.
CODE_REVIEW_SCHEDULE=18:00
ACADEMIC_MORNING_SCHEDULE=08:00
ACADEMIC_END_OF_DAY_SCHEDULE=21:00
FINANCE_MARKET_OPEN_SCHEDULE=09:00
OPS_CONSOLE_USERNAME=
OPS_CONSOLE_PASSWORD=

# Approved source allowlist. Sources remain disabled in the database until
# their vendor credentials and individual approval audit records are present.
# Never substitute open web search for a missing or failed source.
FINANCE_SOURCE_ALLOWLIST_VERSION=finance-sources-2026.09
DVIDS_API_KEY=
EIA_API_KEY=
ALPHA_VANTAGE_API_KEY=
BENZINGA_API_TOKEN=
FMP_API_KEY=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_SECRET=
NOTION_TOKEN=
NOTION_COURSES_DATABASE_ID=
NOTION_ASSESSMENTS_DATABASE_ID=
NOTION_STUDY_BLOCKS_DATABASE_ID=
DISCORD_ACADEMIC_CHANNEL_ID=
